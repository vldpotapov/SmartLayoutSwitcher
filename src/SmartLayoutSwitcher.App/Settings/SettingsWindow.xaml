<Window x:Class="SmartLayoutSwitcher.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SmartLayoutSwitcher.App.Controls"
        xmlns:settings="clr-namespace:SmartLayoutSwitcher.App.Settings"
        Title="Smart Layout Switcher — Settings"
        Icon="/SmartLayoutSwitcher.App;component/Resources/Lang-icon.ico"
        Width="504"
        Height="517"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Card content keeps 10px visual padding: the 1px card border is part of
             that 10px (9px margin), so fixed-height rows are never squeezed. -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#3B3B3B" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="IconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#E6E6E6" />
        </Style>
        <Style x:Key="SectionDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#999999" />
        </Style>
        <Style x:Key="SettingPrimaryStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingLabelStyle}">
            <Setter Property="Foreground" Value="#E6E6E6" />
        </Style>
        <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="31" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Background="#545454" CornerRadius="8">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="1" HorizontalAlignment="Left" Fill="#999999" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#00FFAE" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="#009968" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Background" Value="#454545" />
            <Setter Property="BorderBrush" Value="#545454" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#505050" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3F3F3F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AboutButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="#2C2C2C" />
            <Setter Property="Background" Value="#00FFAE" />
            <Setter Property="BorderBrush" Value="#00FFAE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#20FFBA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#00D996" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" Background="Transparent" CornerRadius="4">
                            <Path Width="15" Height="15" Stretch="Uniform" Fill="#999999"
                                  Data="M 16.3256,15 L 22.5,8.82562 L 21.1744,7.5 L 15,13.6744 L 8.82562,7.5 L 7.5,8.82562 L 13.6744,15 L 7.5,21.1744 L 8.82562,22.5 L 15,16.3256 L 21.1744,22.5 L 22.5,21.1744 L 16.3256,15 Z" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#3B3B3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Background" Value="#3B3B3B" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Width" Value="146.5" />
            <Setter Property="Height" Value="21" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border IsHitTestVisible="False" Background="#3B3B3B" BorderBrush="#545454" BorderThickness="1" CornerRadius="2" Padding="12,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                    <Path Grid.Column="1" Width="8" Height="5" VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Data="M 0.5,0.5 L 4,4 L 7.5,0.5" Stroke="#999999" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Focusable="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}" Margin="0,3,0,0" Padding="2"
                                        Background="#3B3B3B" BorderBrush="#545454" BorderThickness="1" CornerRadius="2">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#2C2C2C" BorderBrush="#454545" BorderThickness="1" CornerRadius="16" ClipToBounds="True"
            MouseLeftButtonDown="HeaderArea_MouseLeftButtonDown">
        <!-- Margins are the Figma 20/24 offsets minus the 1px window border, so the
             fixed-height content still fits inside the border and cannot be clipped. -->
        <Grid Width="460" Height="477" Margin="19,19,23,19" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="37" />
                <RowDefinition Height="12" />
                <RowDefinition Height="49" />
                <RowDefinition Height="6" />
                <RowDefinition Height="65" />
                <RowDefinition Height="6" />
                <RowDefinition Height="82" />
                <RowDefinition Height="6" />
                <RowDefinition Height="82" />
                <RowDefinition Height="6" />
                <RowDefinition Height="84" />
                <RowDefinition Height="14" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="37" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border Width="37" Height="37" Background="#111111" CornerRadius="10" Padding="4">
                    <Image Source="/SmartLayoutSwitcher.App;component/Resources/Lang-icon.png" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold" Foreground="#E6E6E6" Text="Smart Layout Switcher" />
                    <TextBlock FontFamily="Segoe UI" FontSize="12" Foreground="#999999" Text="Switch languages the way you expect" />
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource CloseButtonStyle}" Click="Cancel_Click" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid Margin="10,9,15,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="31" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTileStyle}" VerticalAlignment="Center">
                        <Image Width="18" Height="18" Source="{controls:SvgImage Source=/SmartLayoutSwitcher.App;component/Resources/Settings/enable-dark.svg}" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Enable Smart Layout Switcher" />
                        <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Automatically switch keyboard layout and more" />
                    </StackPanel>
                    <ToggleButton x:Name="EnabledCheckBox" Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource SwitchToggleStyle}" />
                </Grid>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <Grid Margin="10,9,15,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" /><ColumnDefinition Width="15" /><ColumnDefinition Width="90" />
                        <ColumnDefinition Width="15" /><ColumnDefinition Width="1" /><ColumnDefinition Width="15" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTileStyle}" VerticalAlignment="Center">
                        <Image Width="18" Height="18" Source="{controls:SvgImage Source=/SmartLayoutSwitcher.App;component/Resources/Settings/general-dark.svg}" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="General" />
                        <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Basic Behavior" />
                    </StackPanel>
                    <Border Grid.Column="4" Background="#666666" />
                    <Grid Grid.Column="6">
                        <Grid.RowDefinitions><RowDefinition Height="16" /><RowDefinition Height="13" /><RowDefinition Height="16" /></Grid.RowDefinitions>
                        <Grid><TextBlock VerticalAlignment="Center" Style="{StaticResource SettingLabelStyle}" Text="Start with Windows" /><ToggleButton x:Name="StartWithWindowsCheckBox" HorizontalAlignment="Right" Style="{StaticResource SwitchToggleStyle}" /></Grid>
                        <Grid Grid.Row="2"><TextBlock VerticalAlignment="Center" Style="{StaticResource SettingLabelStyle}" Text="Remember layout for each window" /><ToggleButton x:Name="RememberWindowCheckBox" HorizontalAlignment="Right" Style="{StaticResource SwitchToggleStyle}" /></Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="6" Style="{StaticResource CardStyle}">
                <Grid Margin="10,9,15,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" /><ColumnDefinition Width="15" /><ColumnDefinition Width="90" />
                        <ColumnDefinition Width="15" /><ColumnDefinition Width="1" /><ColumnDefinition Width="15" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTileStyle}" VerticalAlignment="Center">
                        <Image Width="18" Height="18" Source="{controls:SvgImage Source=/SmartLayoutSwitcher.App;component/Resources/Settings/switch-dark.svg}" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Switch" />
                        <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Shortcut &amp; behavior" />
                    </StackPanel>
                    <Border Grid.Column="4" Background="#666666" />
                    <Grid Grid.Column="6">
                        <Grid.RowDefinitions><RowDefinition Height="21" /><RowDefinition Height="12" /><RowDefinition Height="29" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SettingLabelStyle}" Text="Keyboard shortcut" />
                            <ComboBox x:Name="HotkeyComboBox" HorizontalAlignment="Right">
                                <ComboBoxItem Tag="{x:Static settings:HotkeyMode.WinSpace}">Win + Space</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static settings:HotkeyMode.LeftAltLeftShift}">Left Alt + Left Shift</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                        <Grid Grid.Row="2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingPrimaryStyle}" Text="Long press layout picker" />
                                <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Hold the keys to cycle through layouts" />
                            </StackPanel>
                            <ToggleButton x:Name="PopupCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SwitchToggleStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="8" Style="{StaticResource CardStyle}">
                <Grid Margin="10,9,15,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" /><ColumnDefinition Width="15" /><ColumnDefinition Width="90" />
                        <ColumnDefinition Width="15" /><ColumnDefinition Width="1" /><ColumnDefinition Width="15" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTileStyle}" VerticalAlignment="Center">
                        <Image Width="18" Height="18" Source="{controls:SvgImage Source=/SmartLayoutSwitcher.App;component/Resources/Settings/text-fix-dark.svg}" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Text Fix" />
                        <TextBlock Width="90" Style="{StaticResource SectionDescriptionStyle}" Text="Automatically fix selected text" />
                    </StackPanel>
                    <Border Grid.Column="4" Background="#666666" />
                    <Grid Grid.Column="6">
                        <Grid.RowDefinitions><RowDefinition Height="21" /><RowDefinition Height="12" /><RowDefinition Height="29" /></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SettingLabelStyle}" Text="Keyboard shortcut" />
                            <Border Width="146.5" Height="21" HorizontalAlignment="Right" Background="#3B3B3B" BorderBrush="#545454" BorderThickness="1" CornerRadius="2" Padding="12,0">
                                <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="10" Foreground="#E6E6E6" Text="Win + Left Alt + Space" />
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SettingPrimaryStyle}" Text="Fix selected text" />
                                <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Converts text to the correct keyboard layout" />
                            </StackPanel>
                            <ToggleButton x:Name="SelectedTextConversionCheckBox" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SwitchToggleStyle}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="10" Style="{StaticResource CardStyle}">
                <Grid Margin="10,9,15,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" /><ColumnDefinition Width="15" /><ColumnDefinition Width="90" />
                        <ColumnDefinition Width="15" /><ColumnDefinition Width="1" /><ColumnDefinition Width="15" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTileStyle}" VerticalAlignment="Center">
                        <Image Width="18" Height="18" Source="{controls:SvgImage Source=/SmartLayoutSwitcher.App;component/Resources/Settings/about-dark.svg}" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="About" />
                        <TextBlock Style="{StaticResource SectionDescriptionStyle}" Text="Version &amp; updates" />
                    </StackPanel>
                    <Border Grid.Column="4" Background="#666666" />
                    <Grid Grid.Column="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="15" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SettingPrimaryStyle}" Text="Smart Layout Switcher" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource SectionDescriptionStyle}" />
                            <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                <Image x:Name="UpdateStatusIcon" Width="12" Height="12" Source="{controls:SvgImage Source=/SmartLayoutSwitcher.App;component/Resources/Actions/success-check.svg}" />
                                <TextBlock x:Name="UpdateStatusText" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource SettingPrimaryStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button Height="27" Style="{StaticResource AboutButtonStyle}" Click="GitHubButton_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Width="15" Height="15" Source="{controls:SvgImage Source=/SmartLayoutSwitcher.App;component/Resources/Actions/github.svg}" />
                                    <TextBlock Margin="6,0,0,0" Text="GitHub" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CheckForUpdatesButton" Margin="0,6,0,0" Height="27" Style="{StaticResource AboutButtonStyle}" Content="Check for updates" Click="CheckForUpdates_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="12" /><ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12" Foreground="#E6E6E6" Text="© 2026 Smart Layout Switcher" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
                <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Content="Save" IsDefault="True" Click="Save_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
