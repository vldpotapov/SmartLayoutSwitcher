<Window x:Class="SmartLayoutSwitcher.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:SmartLayoutSwitcher.App.Settings"
        Title="Smart Layout Switcher — Settings"
        Icon="/SmartLayoutSwitcher.App;component/Resources/Lang-icon.ico"
        Width="430"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <CheckBox x:Name="EnabledCheckBox" Content="Enable Smart Layout Switcher" />
            <CheckBox x:Name="RememberWindowCheckBox" Margin="0,8,0,0" Content="Remember layout for each window" />
            <CheckBox x:Name="PopupCheckBox" Margin="0,8,0,0" Content="Show popup on long press" />
            <CheckBox x:Name="SelectedTextConversionCheckBox" Margin="0,8,0,0"
                      Content="Fix selected text with Win + Left Alt + Space" />
            <CheckBox x:Name="StartWithWindowsCheckBox" Margin="0,8,0,0" Content="Start with Windows" />
        </StackPanel>
        <Image Grid.Row="0"
               Width="40"
               Height="40"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Source="/SmartLayoutSwitcher.App;component/Resources/Lang-icon.png"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <StackPanel Grid.Row="2">
            <TextBlock FontWeight="SemiBold" Text="Shortcut" />
            <ComboBox x:Name="HotkeyComboBox" Margin="0,6,0,0" SelectedIndex="0">
                <ComboBoxItem Tag="{x:Static settings:HotkeyMode.LeftAltLeftShift}">Left Alt + Left Shift</ComboBoxItem>
                <ComboBoxItem Tag="{x:Static settings:HotkeyMode.WinSpace}">Win + Space</ComboBoxItem>
            </ComboBox>
            <TextBlock Margin="0,6,0,0" Foreground="#666666" FontSize="12" TextWrapping="Wrap"
                       Text="Long press: release the second key to cycle layouts; release the first key to apply." />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock FontWeight="SemiBold" Text="GitHub project" />
            <TextBlock Margin="0,6,0,0">
                <Hyperlink x:Name="GitHubLink" RequestNavigate="GitHubLink_RequestNavigate" />
            </TextBlock>
            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button x:Name="CheckForUpdatesButton" Padding="14,4" Content="Check for updates"
                        Click="CheckForUpdates_Click" />
                <TextBlock x:Name="UpdateStatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="#666666" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="6" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel>
                <TextBlock Foreground="#666666" Text="© 2026 Smart Layout Switcher" />
                <TextBlock x:Name="VersionText" Margin="0,3,0,0" Foreground="#666666" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Padding="14,4" Content="Cancel" IsCancel="True" Click="Cancel_Click" />
            <Button Padding="14,4" Content="Save" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
