<Window x:Class="SmartLayoutSwitcher.App.Popup.LayoutPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <!-- Figma "Language popup": 180 wide, radius 20, fill #E5E5E5 @70%,
         stroke #999999 @50%, BACKGROUND_BLUR 20, padding 10, chip radius 10 h40. -->
    <Border x:Name="RootContainer"
            MinWidth="180"
            Background="#B2E5E5E5"
            CornerRadius="20"
            BorderBrush="#80999999"
             BorderThickness="0.5"
            Padding="10"
            SnapsToDevicePixels="True">
        <StackPanel x:Name="ChipsPanel" Orientation="Vertical"/>
    </Border>
</Window>
