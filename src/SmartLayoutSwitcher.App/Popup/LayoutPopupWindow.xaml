<Window x:Class="SmartLayoutSwitcher.App.Popup.LayoutPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <!-- Figma "Language popup": 180 wide, radius 20, fill #F2F2F2 @60%,
         stroke #808080 @60%, BACKGROUND_BLUR 15, padding 10, chip radius 10 h40. -->
    <Border x:Name="RootContainer"
            MinWidth="180"
            Background="#99F2F2F2"
            CornerRadius="20"
            BorderBrush="#99808080"
            BorderThickness="0.5"
            Padding="10"
            SnapsToDevicePixels="True">
        <StackPanel x:Name="ChipsPanel" Orientation="Vertical"/>
    </Border>
</Window>
