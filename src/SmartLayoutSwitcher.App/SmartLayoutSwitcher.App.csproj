<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SmartLayoutSwitcher.Core\SmartLayoutSwitcher.Core.csproj" />
    <ProjectReference Include="..\SmartLayoutSwitcher.Native\SmartLayoutSwitcher.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseSystemDrawing>true</UseSystemDrawing>
    <ApplicationIcon>..\..\assets\installer\Lang-icon.ico</ApplicationIcon>
    <Version>1.0.16</Version>
    <InformationalVersion>1.0.16</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\installer\Lang-icon.ico">
      <LogicalName>SmartLayoutSwitcher.App.Resources.LangIcon.ico</LogicalName>
    </EmbeddedResource>
    <Resource Include="..\..\assets\installer\Lang-icon.ico">
      <Link>Resources\Lang-icon.ico</Link>
    </Resource>
    <Resource Include="..\..\assets\installer\Lang-icon.png">
      <Link>Resources\Lang-icon.png</Link>
    </Resource>
  </ItemGroup>

</Project>
